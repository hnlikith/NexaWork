# ============================================================
# NexaWork — Environment Variables
# Platform Transformation: MongoDB → Supabase
# Copy this file to .env.local and fill in all values
# ============================================================


# ─────────────────────────────────────────────
# SUPABASE (Primary — DB + Auth + Storage + Realtime)
# supabase.com → Project → Settings → API
# ─────────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY_HERE
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET_HERE
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://YOUR_PROJECT_REF.supabase.co/storage/v1


# ─────────────────────────────────────────────
# APP CONFIG
# ─────────────────────────────────────────────

# Base URL — single source of truth for all magic links + reset/activation/webhook URLs.
# Production: your domain.  Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_APP_NAME=NexaWork
NODE_ENV=development


# ─────────────────────────────────────────────
# GOOGLE MEET API (Module 12 — Meetings & Scheduling)
# console.cloud.google.com → APIs → Google Calendar API
# ─────────────────────────────────────────────

GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
GOOGLE_CALENDAR_ID=primary


# ─────────────────────────────────────────────
# POWER BI (Module 10 — Analytics & Reporting)
# app.powerbi.com → Workspace → Settings
# ─────────────────────────────────────────────

POWERBI_CLIENT_ID=YOUR_POWERBI_APP_CLIENT_ID
POWERBI_CLIENT_SECRET=YOUR_POWERBI_APP_CLIENT_SECRET
POWERBI_TENANT_ID=YOUR_AZURE_TENANT_ID
POWERBI_WORKSPACE_ID=YOUR_POWERBI_WORKSPACE_ID


# ─────────────────────────────────────────────
# PUSH NOTIFICATIONS (Module 13 — Flutter Mobile App)
# Firebase Cloud Messaging — Firebase Console
# ─────────────────────────────────────────────

FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_FIREBASE_KEY\n-----END RSA PRIVATE KEY-----"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com


# ─────────────────────────────────────────────
# ZOHO MAIL + CALENDAR INTEGRATION
# api-console.zoho.com → Register Server-based App
# ─────────────────────────────────────────────

ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_MAIL_API_URL=https://mail.zoho.in/api
ZOHO_CALENDAR_URL=https://calendar.zoho.in/api/v1
ZOHO_MAIL_DOMAIN=your-company.com
# Org-level admin OAuth tokens (stored in zoho_config table after first connect)
# Set these in Zoho admin after completing OAuth consent:
# ZOHO_CLIENT_ID=YOUR_ZOHO_CLIENT_ID
# ZOHO_CLIENT_SECRET=YOUR_ZOHO_CLIENT_SECRET
# ZOHO_REDIRECT_URI=https://your-domain.com/api/auth/zoho/callback


# ─────────────────────────────────────────────
# EMAIL / SMTP (Approval flows, renewal alerts)
# ─────────────────────────────────────────────

SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=noreply@your-company.com
SMTP_PASS=YOUR_SMTP_PASSWORD
SMTP_FROM=NexaWork <noreply@your-company.com>


# ─────────────────────────────────────────────
# LEGACY — keep during parallel migration only
# Remove after Supabase cutover is verified
# ─────────────────────────────────────────────

MONGODB_URI=mongodb://localhost:27017/nexawork
SESSION_SECRET=your-iron-session-secret-min-32-chars-here
JWT_SECRET=your-jwt-secret-key


# ─────────────────────────────────────────────
# OPTIONAL — scoped payroll-intern access
# Comma-separated list of employee emails granted access to only the
# internship stipend pages. Leave unset to disable this special access.
# ─────────────────────────────────────────────

# PAYROLL_INTERN_EMAILS=intern1@your-company.com,intern2@your-company.com


# ─────────────────────────────────────────────
# AI / LLM INFERENCE
# Powers mail classification, summaries, reply suggestions, tone/length
# rewriting, subject suggestions, and the workspace AI assistant.
#
# All values below are OPTIONAL. With none set, AI features fall back to
# deterministic non-AI defaults and the rest of the app is unaffected.
# ─────────────────────────────────────────────

# OpenRouter — primary inference. When set, requests walk an ordered
# multi-model fallback chain (strongest first, 10s timeout per model).
# openrouter.ai → Keys
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Ollama-compatible endpoint — used as the fallback when the OpenRouter
# chain is exhausted or no OpenRouter key is set. Must be the generate
# endpoint, e.g. http://localhost:11434/api/generate
LOCAL_AI_ENDPOINT=http://localhost:11434/api/generate

# Model name served by the endpoint above. Defaults to gemma4:e4b if unset.
LOCAL_AI_MODEL=your_local_model

# Bearer token for the local AI endpoint / proxy. Optional — omit if the
# endpoint is unauthenticated.
AI_BRIDGE_KEY=your_ai_bridge_key_here

# Anthropic Claude — used ONLY by the meeting-transcript analysis route
# (/api/meetings/analyze). That route returns 500 if this is not set.
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here
